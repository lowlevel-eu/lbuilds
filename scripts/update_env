#!/bin/bash
LOST_SRC=$1
ARCH=i386
ENV=`pwd`/env

show_usage() {
	echo "Aufruf: scripts/update_env <Pfad zum tyndur-Quellcode>"
	exit -1
}

[ $# -ne 1 ] && show_usage
[ ! -d $LOST_SRC ] && show_usage

# Verzeichnisstruktur anlegen
mkdir -p ${ENV}/bin
mkdir -p ${ENV}/lib
mkdir -p ${ENV}/lib64
mkdir -p ${ENV}/include
mkdir -p ${ENV}/pascal/units

mkdir -p ${ENV}/system/links

rm -f ${ENV}/system/links/bin
ln -s -f ${ENV}/bin ${ENV}/system/links/bin
rm -f ${ENV}/system/links/lib
ln -s -f ${ENV}/lib ${ENV}/system/links/lib
rm -f ${ENV}/system/links/lib64
ln -s -f ${ENV}/lib64 ${ENV}/system/links/lib64
rm -f ${ENV}/system/links/include
ln -s -f ${ENV}/include ${ENV}/system/links/include

cp ${LOST_SRC}/src/modules/lib/crt0.o ${ENV}/lib/crttyndur.o

# Header verlinken
for h in ${LOST_SRC}/src/include/* ${LOST_SRC}/src/include/arch/${ARCH}/* ${LOST_SRC}/src/modules/include/* ${LOST_SRC}/src/modules/include/arch/${ARCH}/*; do
    echo $h
    [ -e $h ] && cp -rLf $h ${ENV}/include/
done
rm -rf `find ${ENV}/ -name .svn`

# Libc erstellen
rm -f ${ENV}/lib/libc.a
ar rs ${ENV}/lib/libc.a `find ${LOST_SRC}/src/lib -name '*.o'` `find ${LOST_SRC}/src/modules/lib -name '*.o'` > /dev/null
ar rs ${ENV}/lib/libm.a  ${LOST_SRC}/src/modules/lib/stdlibc/math/*.o
ln -s -f ${ENV}/lib/libc.a ${ENV}/lib/libg.a

# Pascal-Kram nur kopieren wenn er auch kompiliert wurde
if [ -f ${LOST_SRC}/src/modules/pas/lib/prt0.o ]; then
    cp ${LOST_SRC}/src/modules/pas/lib/prt0.o ${ENV}/pascal/units
    cp ${LOST_SRC}/src/modules/pas/lib/units/* ${ENV}/pascal/units/
fi

# Pruefen, ob libc-Stubs vorhanden sind
if (grep '#define CONFIG_LIBC_NO_STUBS' ${ENV}/include/lost/config.h > /dev/null); then
    echo -e "\033[01;31m*\n* CONFIG_LIBC_NO_STUBS ist gesetzt! Einige lbuilds funktionieren so nicht.\n* make menuconfig; make clean; make im tyndur-Verzeichnis, dann nochmal versuchen.\n*\033[01;37m"
fi
