-    ret = getpeername (sock, sockaddr, &addrlen);
+    ret = -1; //getpeername (sock, sockaddr, &addrlen);
   else
     abort ();
   if (ret < 0)
@@ -712,13 +712,25 @@ sock_poll (int fd, double timeout, int w
   return select_fd (fd, timeout, wait_for);
 }
 
+#define MSG_PEEK 0
 static int
 sock_peek (int fd, char *buf, int bufsize)
 {
   int res;
+  fprintf(stderr, "sock_peek!\n");
   do
     res = recv (fd, buf, bufsize, MSG_PEEK);
   while (res == -1 && errno == EINTR);
+
+  if (res > 0) {
+      int i;
+      FILE* f = fdopen(fd, NULL);
+      for (i = res - 1; i >= 0; i--) {
+          ungetc(buf[i], f);
+      }
+  }
+
+
   return res;
 }
 
