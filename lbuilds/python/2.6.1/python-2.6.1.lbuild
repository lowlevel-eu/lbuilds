include lutils
include toolchain

DESCRIPTION="Python Programming Language"
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/Python"
SRC_URI="http://www.python.org/ftp/python/2.6.1/Python-2.6.1.tar.bz2"

LICENSE="Python License"

BUILD_DEPEND=""
RUN_DEPEND=""

MY_P="Python-${PV}"
MY_S="${S}/${MY_P}"

src_unpack() {
	lunpack Python-${PV}.tar.bz2 || die "unpacking failed"
	cd ${MY_S}

    ln -s ${F} patches
    [ -f ${F}/series ] && ln -s ${F}/series series
    for i in ${F}/*.patch; do
        [ -L series ] || echo `basename $i` >> series
        (which quilt > /dev/null 2>&1) || (patch -p1 < $i) || die "Fehler beim Anwenden von $i"
    done
    (which quilt > /dev/null 2>&1) && (quilt push -a || die "Fehler beim Anwenden der Patches")
}

src_configure() {
	cd ${MY_S}
	./configure \
		CC="`tc-cc` -DWITHOUT_COMPLEX" \
		--build=`tc-build` \
		--target=`tc-host` \
		--host=`tc-host` \
		--prefix="${R}" \
		|| die "configure failed"
}

src_compile() {
	cd ${MY_S}
	lmake || die "make failed"
}

src_install() {
	cd ${MY_S}
	lmake DESTDIR="${D}" install || die "make install failed"
    rm ${D}/${R}/bin/python
    ln -s python2.6 ${D}/${R}/bin/python
    rm ${D}/${R}/bin/python-config
    rm ${D}/${R}/bin/python2.6-config
    rm -r ${D}/${R}/lib/python2.6/test
    rm -r ${D}/${R}/lib/python2.6/config
    rm -r ${D}/${R}/lib/python2.6/distutils
    rm -r ${D}/${R}/lib/python2.6/email
    rm -r ${D}/${R}/lib/python2.6/encodings
}
