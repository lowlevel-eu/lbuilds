Index: src/git-1.6.4/compat/tyndur.h
===================================================================
--- /dev/null
+++ src/git-1.6.4/compat/tyndur.h
@@ -0,0 +1,156 @@
+#ifndef COMPAT_TYNDUR_H
+#define COMPAT_TYNDUR_H
+
+#include <stdio.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netdb.h>
+#include <pwd.h>
+#include <io.h>
+#include <sys/select.h>
+#include <time.h>
+#include <signal.h>
+#include <unistd.h>
+#include <errno.h>
+#include <readline/readline.h>
+
+#define ECONNABORTED 2001
+
+#define has_dos_drive_prefix(x) _service_absolute(x)
+
+static int _service_absolute(const char* path)
+{
+    const char* colon = strchr(path, ':');
+    const char* pipe = strchr(path, '|');
+    const char* slash = strchr(path, '/');
+
+    return
+        colon
+        && (!pipe || colon < pipe)
+        && (!slash || colon < slash);
+}
+
+
+static inline int _symlink(const char *oldpath, const char *newpath)
+{ errno = ENOSYS; return -1; }
+#define symlink _symlink
+
+/* fnmatch.h */
+enum {
+    FNM_NOMATCH,
+    FNM_PATHNAME,
+    FNM_PERIOD,
+    FNM_NOESCAPE,
+    FNM_NOSYS,
+};
+
+static int fnmatch(const char* pattern, const char* string, int flags)
+{
+    printf("<fnmatch called>");
+    return -1;
+}
+
+/* time.h */
+enum {
+    ITIMER_REAL,
+    ITIMER_VIRTUAL,
+    ITIMER_PROF,
+};
+
+struct itimerval {
+    struct timeval it_interval;
+    struct timeval it_value;
+};
+
+static int setitimer(int timer, const struct itimerval* v,
+    struct itimerval* old_v)
+{
+    if (timer == ITIMER_REAL) {
+        alarm(v->it_value.tv_sec);
+        return 0;
+    } else {
+        errno = EINVAL;
+        return -1;
+    }
+}
+
+/* signal.h */
+#define SA_RESTART 0
+
+/* unistd.h */
+static int fsync(int fd)
+{
+    return 0;
+}
+
+static pid_t setsid(void)
+{
+    return getpid();
+}
+
+static int setuid(uid_t uid)
+{
+    return 0;
+}
+
+static int setgid(gid_t gid)
+{
+    return 0;
+}
+
+static int initgroups(const char *user, gid_t group)
+{
+    return 0;
+}
+
+static char *getpass(const char *prompt)
+{
+    return readline(prompt);
+}
+
+/* wait.h */
+#define WIFSIGNALED(x) 0
+#define WIFEXITED(x) 1
+#define WEXITSTATUS(x) (x)
+
+#define WNOHANG 0
+
+/* poll.h */
+enum {
+    POLLIN  = 1,
+    POLLHUP = 2,
+    POLLOUT = 4,
+};
+
+struct pollfd {
+    int fd;
+    short events;
+    short revents;
+};
+
+static int poll(struct pollfd *fds, int nfds, int timeout)
+{
+    int i;
+    int ret = 0;
+
+    for (i = 0; i < nfds; i++) {
+        fds[i].revents = (POLLIN | POLLOUT) & fds[i].events;
+        if (fds[i].revents) {
+            ret++;
+        }
+    }
+
+    return ret;
+}
+
+/* syslog.h */
+enum {
+    LOG_ERR,
+    LOG_INFO,
+};
+
+/* netinet/in.h */
+#define INADDR_ANY 0
+
+#endif
