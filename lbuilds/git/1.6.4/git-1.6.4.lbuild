include lutils
include toolchain

DESCRIPTION=""
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/git"
SRC_URI="http://www.kernel.org/pub/software/scm/git/${P}.tar.bz2"

LICENSE="GPL-2"

RUN_DEPEND=""
BUILD_DEPEND="=zlib-1.2.3"

MY_S="${S}/${P}"

src_configure() {
	cd ${MY_S}

    autoconf || die "autoconf ist fehlgeschlagen"
	./configure \
		CC=`tc-cc` \
		CFLAGS="-I `tc-incdir` -L `tc-libdir`" \
		--build=`tc-build` \
		--target=`tc-host` \
		--host=`tc-host` \
		--prefix="${R}" \
		|| die "configure failed"
}

src_compile() {
	cd ${MY_S}

	lmake || die "make failed"
	cd ..
}

src_install() {
	cd ${MY_S}
	lmake -j1 DESTDIR="${D}" install || die "make install failed"
}
