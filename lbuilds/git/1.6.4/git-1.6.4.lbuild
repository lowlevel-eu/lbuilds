include lutils
include toolchain

DESCRIPTION=""
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/git"
SRC_URI="https://github.com/git/git/archive/v${PV}.tar.gz"

LICENSE="GPL-2"

RUN_DEPEND=""
BUILD_DEPEND="=zlib-1.2.8"

MY_S="${S}/${P}"

src_configure() {
	cd ${MY_S}

    autoconf || die "autoconf ist fehlgeschlagen"
	./configure \
		CC=`tc-cc` \
		CFLAGS="-I `tc-incdir` -L `tc-libdir`" \
		--build=`tc-build` \
		--target=`tc-host` \
		--host=`tc-host` \
		--prefix="${R}" \
		|| die "configure failed"
}

src_compile() {
	cd ${MY_S}

	lmake || die "make failed"
	cd ..
}

src_install() {
	cd ${MY_S}
	lmake -j1 DESTDIR="${D}" install || die "make install failed"
    mkdir "${D}/${R}/etc"
    cat > "${D}/${R}/etc/gitconfig" <<EOF
[color]
    ui = auto
    branch = auto
    diff = auto
    status = auto
EOF
}
