+                        ;;
 i[3-7]86-*-sysv[45]*)	targ_emul=elf_i386 ;;
 i[3-7]86-*-solaris2*)	targ_emul=elf_i386_ldso
                         targ_extra_emuls="elf_i386 elf_x86_64"
@@ -680,6 +684,9 @@ i[03-9x]86-*-cygwin*)
 *-*-linux*)
   ;;
 
+*-*-tyndur*)
+  NATIVE_LIB_DIRS='file:/system/lib'
+  ;;
 *-*-freebsd* | *-*-dragonfly*)
