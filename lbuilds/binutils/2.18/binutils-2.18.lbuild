include lutils
include toolchain

DESCRIPTION="Tools necessary to build programs"
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/Binutils"
SRC_URI="http://ftp.gnu.org/gnu/binutils/${P}.tar.bz2"

LICENSE="GPL-2"

BUILD_DEPEND=""
RUN_DEPEND=""

MY_S="${S}/${P}"

src_unpack() {
	lunpack binutils-${PV}.tar.bz2
	cd ${MY_S} && lpatch ${F}/${P}.patch || die "patching failed"
}

src_compile() {
	mkdir build
	cd build

	../${P}/configure \
		--build=`tc-build` \
		--host=`tc-host` \
		--target=`tc-host` \
		--prefix=${R} \
		--disable-nls \
		|| die "configure failed"

	lmake || die "make failed"
	cd ..
}

src_install() {
	cd build
	lmake DESTDIR="${D}" install || die "make install failed"

	# Die Manpages brauchen wir nicht im Paket
	rm -r ${D}/${R}/man ${D}/${R}/info ${D}/${R}/lib ${D}/${R}/include \
		${D}/${R}/`tc-host`

	# Das Paket noch ein bisschen kleiner machen
	cd "${D}/${R}/bin"
	rm addr2line c++filt gprof nm objcopy ranlib readelf size strings
}
