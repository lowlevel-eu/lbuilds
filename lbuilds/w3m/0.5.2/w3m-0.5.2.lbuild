include lutils
include toolchain

DESCRIPTION=""
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/w3m"
SRC_URI="http://switch.dl.sourceforge.net/sourceforge/w3m/w3m-0.5.2.tar.gz"

LICENSE="GPL"

RUN_DEPEND=""
BUILD_DEPEND="=ncurses-5.6 =boehmgc-6.2"

MY_S="${S}/${P}"

src_unpack() {
	lunpack ${P}.tar.gz
	cd ${MY_S}

    ln -s ${F} patches
    [ -f ${F}/series ] && ln -s ${F}/series series
    for i in ${F}/*.patch; do
        [ -L series ] || echo `basename $i` >> series
        (which quilt > /dev/null 2>&1) || (patch -p1 < $i) || die "Fehler beim Anwenden von $i"
    done
    (which quilt > /dev/null 2>&1) && (quilt push -a || die "Fehler beim Anwenden der Patches")
}

src_configure() {
	cd ${MY_S}

	./configure \
		CC=`tc-cc` \
		CFLAGS="-I `tc-incdir`/ncurses -I `tc-incdir` -L `tc-libdir` -lncurses -lm" \
		LDFLAGS="-L `tc-libdir` -lncurses" \
		--build=`tc-build` \
		--target=`tc-host` \
		--host=`tc-host` \
		--prefix="${R}" \
        --disable-mouse \
        --disable-xface \
        --disable-ipv6 \
        --disable-image \
		|| die "configure failed"
}

src_compile() {
	cd ${MY_S}
	lmake || die "make failed"
	cd ..
}

src_install() {
	cd ${MY_S}
	lmake DESTDIR="${D}" install || die "make install failed"
    rm ${D}/${R}/bin/w3mman
}
