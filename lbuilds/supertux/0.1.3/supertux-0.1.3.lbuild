include lutils
include toolchain

DESCRIPTION=""
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/Supertux"
SRC_URI="https://github.com/SuperTux/supertux/releases/download/v${PV}/${P}.tar.bz2"

LICENSE="LGPL-2"

RUN_DEPEND=""
BUILD_DEPEND="=sdl-1.2.14 =sdl-image-1.2.10 =sdl-mixer-1.2.11 =zlib-1.2.8 =libstdc++-4.5.2 =libpng-1.4.12 =libjpeg-8b"

MY_S="${S}/${P}"

src_configure() {
	cd ${MY_S}

	./configure \
		CC=`tc-cc` \
		CXXFLAGS="-nostdinc -I `tc-incdir` -I `tc-incdir`/c++/4.5.2 -I `tc-incdir`/c++/4.5.2/i386-pc-tyndur -I `tc-incdir`/SDL -L`tc-libdir`" \
        LIBS="-lpng -lz -ljpeg" \
		--host=`tc-host` \
		--prefix="${R}" \
		|| die "configure failed"
}

src_compile() {
	cd ${MY_S}

	lmake || die "make failed"
	cd ..
}

src_install() {
	cd ${MY_S}

	# Sonst gibts Fehler
	mkdir -p "${D}${R}/bin"
	lmake -j1 DESTDIR="${D}" install || die "make install failed"
}
