DESCRIPTION=""
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/zlib"
SRC_URI="http://www.gzip.org/zlib/${P}.tar.gz"

LICENSE="GPL-2"

BUILD_DEPEND=""
RUN_DEPEND=""

MY_S="${S}/${P}"

src_unpack() {
	unpack ${P}.tar.gz
}

src_compile() {
	cd ${MY_S}
	
	CC=`tc-cc` prefix="${D}${R}" ./configure \
		|| die "configure failed"

	lmake || die "make failed"
	cd ..
}

src_install() {
	cd ${MY_S}

	lmake install prefix="${D}${R}" || die "make install failed"
	rm -rf ${D}${R}/share
}
