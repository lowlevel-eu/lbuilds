include toolchain
include lutils

DESCRIPTION=""
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/zlib"
SRC_URI="http://zlib.net/${P}.tar.gz"
PS="lib"

LICENSE="zlib"

BUILD_DEPEND=""
RUN_DEPEND=""

MY_S="${S}/${P}"

src_configure() {
	cd ${MY_S}

    # Das libz-configure hat zwar ein --static, aber das ist kaputt.
    # Stattdessen löschen wir alles dynamische hinterher wieder manuell.
	CC=`tc-cc` prefix="${D}${R}" ./configure \
		|| die "configure failed"
}

src_compile() {
	cd ${MY_S}
	lmake || die "make failed"
	cd ..
}

src_install() {
	cd ${MY_S}

	lmake install prefix="${D}${R}" || die "make install failed"
	rm -rf ${D}${R}/share
	rm -rf ${D}${R}/lib/*.so*
}
