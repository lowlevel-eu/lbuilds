Index: src/coreutils-7.4/lib/freadahead.c
===================================================================
--- src.orig/coreutils-7.4/lib/freadahead.c
+++ src/coreutils-7.4/lib/freadahead.c
@@ -79,6 +79,8 @@ freadahead (FILE *fp)
 #elif defined SLOW_BUT_NO_HACKS     /* users can define this */
   abort ();
   return 0;
+#elif defined __TYNDUR__
