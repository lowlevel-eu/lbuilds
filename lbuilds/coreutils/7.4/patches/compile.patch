Index: src/coreutils-7.4/lib/freadseek.c
===================================================================
--- src.orig/coreutils-7.4/lib/freadseek.c
+++ src/coreutils-7.4/lib/freadseek.c
@@ -55,6 +55,9 @@ freadptrinc (FILE *fp, size_t increment)
   fp->_Next += increment;
 #elif defined __MINT__              /* Atari FreeMiNT */
   fp->__bufp += increment;
+#elif defined __TYNDUR__
+  unsigned char buf[increment];
+  fread(buf, increment, 1, fp);
 #elif defined SLOW_BUT_NO_HACKS     /* users can define this */
 #else
  #error "Please port gnulib freadseek.c to your platform! Look at the definition of getc, getc_unlocked on your system, then report this to bug-gnulib."
