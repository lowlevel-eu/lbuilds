include lutils
include toolchain

DESCRIPTION=""
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/vim"
SRC_URI="ftp://ftp.vim.org/pub/vim/unix/vim-8.0.tar.bz2"

LICENSE="vim"

RUN_DEPEND=""
BUILD_DEPEND="=ncurses-5.6"

MY_S="${S}/vim80"

src_configure() {
    cd ${MY_S}

    ./configure \
        CC=`tc-cc` \
        vim_cv_toupper_broken=no \
        vim_cv_terminfo=yes \
        vim_cv_tty_group=world \
        vim_cv_tty_mode=0620 \
        vim_cv_getcwd_broken=no \
        vim_cv_stat_ignores_slash=yes \
        vim_cv_memmove_handles_overlap=yes \
        --build=`tc-build` \
        --target=`tc-host` \
        --host=`tc-host` \
        --prefix="${R}" \
        --with-tlib=ncurses \
        --disable-channel \
        || die "configure failed"
}

src_compile() {
	cd ${MY_S}
	lmake
}

src_install() {
    cd ${MY_S}
    lmake DESTDIR="${D}" install || die "make install failed"
}
