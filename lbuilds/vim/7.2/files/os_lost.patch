+mch_screenmode(arg)
+    char_u   *arg;
+{
+    return FAIL;
+}
+
+    int
+mch_nodetype(name)
+    char_u	*name;
+{
+    struct stat	st;
+
+    if (stat((char *)name, &st))
+	return NODE_NORMAL;
+    if (S_ISREG(st.st_mode) || S_ISDIR(st.st_mode))
+	return NODE_NORMAL;
+#ifndef OS2
+    if (S_ISBLK(st.st_mode))	/* block device isn't writable */
+	return NODE_OTHER;
+#endif
+    /* Everything else is writable? */
+    return NODE_WRITABLE;
+}
