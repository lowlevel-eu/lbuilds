+}
+
+int mch_isFullName(char_u *fname)
+{
+    // FIXME Erkennt nur servicerelative Pfade
+    return *fname == '/';
+}
+
+int mch_FullName(fname, buf, len, force)
+    char_u	*fname, *buf;
+    int		len;
+    int		force;		/* also expand when already absolute path */
+{
+    char* res = io_get_absolute_path(fname);
+
+    if (res) {
+	vim_strncpy(buf, res, len - 1);
+	free(res);
+	return OK;
+    }
