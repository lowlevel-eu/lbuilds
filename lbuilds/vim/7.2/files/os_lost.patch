+int
+mch_inchar(buf, maxlen, wtime, tb_change_cnt)
+    char_u	*buf;
+    int		maxlen;
+    long	wtime;	    /* don't use "time", MIPS cannot handle it */
+    int		tb_change_cnt;
+{
+    lio_stream_t fd = file_get_stream(stdin);
+    int c, ret;
+    uint64_t timeout;
+    int n = 0;
+
+    switch (wtime) {
+	case -1: timeout = 0; break;
+	case  0: timeout = get_tick_count(); break;
+	default: timeout = get_tick_count() + 500; break;
+    }
+
+    do {
+	ret = lio_readf(fd, 0, 1, &c, LIO_REQ_FILEPOS);
+	if (ret > 0) {
+	    n++;
+	    *buf = (char_u) c;
+	    buf++;
+	} else if (n > 0) {
+	    break;
+	}
+    } while ((n < maxlen) && (!timeout || get_tick_count() < timeout));
+
+    return n;
+}
