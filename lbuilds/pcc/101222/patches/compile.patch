@@ -1293,6 +1293,85 @@ callsys(char *f, char *v[])
 	return (exitCode != 0);
 }
 
+#elif defined(TYNDUR)
+
+#include <init.h>
+
+int
+callsys(char* executable, char* argv[])
+{
+    int i;
+    long pid = 0;
+    int status = 0;
+
+	if (vflag) {
+		fprintf(stderr, "%s ", executable);
+		for (i = 1; argv[i]; i++)
+			fprintf(stderr, "%s ", argv[i]);
+		fprintf(stderr, "\n");
+	}
+
+#if 0
+    /* We are going to copy the path to the executable and all the
+       arguments into one string because there is no other possibility
+       at the moment for TYNDUR.  */
+    size_t len;
+
+    /* Calculate the total length of the commandline.  */
+    len = strlen(executable);
+    if (Bflag) {
+        len += strlen(Bflag);
+    }
+
+    for (i = 1; argv[i] != NULL; i++) {
+        len += strlen(argv[i]) + 1;
+    }
+
+    /* We need a new block because of the dynamically sized array.  */
+    do {
+        char cmd[len];
+        int pos = 0;
+
+        if (Bflag) {
+            const char* s;
+
+            strcpy(cmd, Bflag);
+            s = strrchr(executable, '/');
+            if (s) {
+                strcat(cmd, s);
+            } else {
+                strcat(cmd, executable);
+            }
+        } else {
+            strcpy(cmd, executable);
+        }
+
+        pos = strlen(cmd);
+        for (i = 1; argv[i] != NULL; i++) {
+            cmd[pos++] = ' ';
+            strcpy (cmd + pos, argv[i]);
+            pos += strlen (argv[i]);
+        }
+
+        /* Now that we have the command string the hard part is done.  */
+        pid = init_execute(cmd);
+    } while (0);
+#else
+    pid = init_execv(executable, (const char**) argv);
+#endif
+
+    if (pid == 0) {
+		fprintf(stderr, "Could not start '%s'\n", executable);
+        return 100;
+    }
+	while (waitpid(pid, &status, 0) == -1 && errno == EINTR)
+		;
+	if (WIFEXITED(status))
+		return (WEXITSTATUS(status));
+
+	return 0;
+}
+
 #else
 
