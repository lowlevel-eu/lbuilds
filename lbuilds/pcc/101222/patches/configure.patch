Index: src/pcc-101222/config.sub
===================================================================
--- src.orig/pcc-101222/config.sub
+++ src/pcc-101222/config.sub
@@ -1258,7 +1258,7 @@ case $os in
 	      | -os2* | -vos* | -palmos* | -uclinux* | -nucleus* \
 	      | -morphos* | -superux* | -rtmk* | -rtmk-nova* | -windiss* \
 	      | -powermax* | -dnix* | -nx6 | -nx7 | -sei* | -dragonfly* \
-	      | -skyos* | -haiku* | -rdos* | -toppers* | -drops*)
+	      | -skyos* | -haiku* | -rdos* | -toppers* | -drops* | -tyndur* )
 	# Remember, each alternative MUST END IN *, to match a version number.
 		;;
 	-qnx*)
Index: src/pcc-101222/configure.ac
===================================================================
--- src.orig/pcc-101222/configure.ac
+++ src/pcc-101222/configure.ac
@@ -177,6 +177,14 @@ case "$target_os" in
         esac
         ;;
 
+    tyndur*)
+	targos=tyndur
+	abi=elf
+	case "$target_cpu" in
+	    i?86) targmach=i386 ;;
+	esac
+	;;
+
     windows*|pe*)
 	target_alias=i386-pe
 	targos=win32
