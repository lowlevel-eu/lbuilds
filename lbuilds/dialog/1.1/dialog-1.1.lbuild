include lutils
include toolchain

DESCRIPTION=""
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/dialog"
SRC_URI="ftp://invisible-island.net/dialog/dialog-1.1-20100428.tgz"

LICENSE="LGPL-2"

RUN_DEPEND=""
BUILD_DEPEND="=ncurses-5.6"

MY_S="${S}/dialog-1.1-20100428"

src_compile() {
	cd ${MY_S}

	./configure \
		CC=`tc-cc` \
		CFLAGS="-I `tc-incdir`/ncurses -I `tc-incdir` -L `tc-libdir` -lncurses" \
		--build=`tc-build` \
		--target=`tc-host` \
		--host=`tc-host` \
		--prefix="${R}" \
		|| die "configure failed"

	lmake || die "make failed"
	cd ..
}

src_install() {
	cd ${MY_S}

	# Sonst gibts Fehler
	mkdir -p "${D}${R}/bin"
	lmake -j1 DESTDIR="${D}" install || die "make install failed"
}
