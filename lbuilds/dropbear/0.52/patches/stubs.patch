+char* getpass(char* prompt) {
+    static char pass[129];
+    int i;
+    char c;
+
+    printf("%s", prompt);
+    fflush(stdout);
+
+    for (i = 0; (i < sizeof(pass) - 1); i++) {
+        while (((c = fgetc(stdin)) == EOF) && !feof(stdin)) {}
+        if (feof(stdin)) {
+            return NULL;
+        }
+
+        if (c == '\b') {
+            printf("\033[1D \033[1D");
+            fflush(stdout);
+            i--;
+        } else if (c == '\n') {
+            pass[i] = 0;
+            break;
+        } else {
+            pass[i] = c;
+            putchar('*');
+            fflush(stdout);
+        }
+    }
+
+    puts("");
+    return pass;
+}
