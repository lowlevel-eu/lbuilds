include lutils
include toolchain

DESCRIPTION=""
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/w3m"
SRC_URI="http://www.sic.med.tohoku.ac.jp/~satodai/w3m/src/boehm-gc/gc6.2.tar.gz"
PS="lib"

LICENSE="MIT"

RUN_DEPEND=""
BUILD_DEPEND=""

MY_S="${S}/gc6.2"

src_unpack() {
	lunpack gc6.2.tar.gz
	cd ${MY_S}

    ln -s ${F} patches
    [ -f ${F}/series ] && ln -s ${F}/series series
    for i in ${F}/*.patch; do
        [ -L series ] || echo `basename $i` >> series
        (which quilt > /dev/null 2>&1) || (patch -p1 < $i) || die "Fehler beim Anwenden von $i"
    done
    (which quilt > /dev/null 2>&1) && quilt push -a || die "Fehler beim Anwenden der Patches"
}

src_configure() {
	cd ${MY_S}

	./configure \
		CC=`tc-cc` \
		--build=`tc-build` \
		--target=`tc-host` \
		--host=`tc-host` \
		--prefix="${R}" \
        --disable-mouse \
        --disable-ipv6 \
		|| die "configure failed"
}

src_compile() {
	cd ${MY_S}
	lmake || die "make failed"
	cd ..
}

src_install() {
	cd ${MY_S}
	lmake DESTDIR="${D}" install || die "make install failed"
}
