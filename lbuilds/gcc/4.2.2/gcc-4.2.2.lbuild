include lutils
include toolchain

DESCRIPTION="GNU C-Compiler"
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/GCC"
SRC_URI="http://ftp.gnu.org/gnu/gcc/gcc-${PV}/gcc-core-${PV}.tar.bz2"

LICENSE="GPL-2"

BUILD_DEPEND=""
RUN_DEPEND=""


PREFIX="/usr"

MY_S="${S}/${P}"

src_unpack() {
	lunpack gcc-core-${PV}.tar.bz2
	cd ${MY_S} && lpatch ${F}/gcc-${PV}.patch || die "patching failed"
}

src_compile() {
	cd ${MY_S}
	mkdir build
	cd build

	# Sonst benutzt der gcc unsere CFlags auch fuer Tools die fuer den Host bestimmt sind
	export CFLAGS_FOR_TARGET="$CFLAGS $CPPFLAGS"
	export CFLAGS=""
	export CPPFLAGS=""

	../configure \
		--build=`tc-build` \
		--host=`tc-host` \
		--target=`tc-host` \
		--prefix=${R} \
		--disable-nls \
		--enable-languages=c \
		--disable-shared \
		--without-headers \
		--disable-libssp \
		|| die "configure failed"

	lmake || die "make failed"
	cd ..
}

src_install() {
	cd ${MY_S}/build
	lmake DESTDIR="${D}" install || die "make install failed"

	rm -r ${D}${R}/libexec/gcc/`tc-host`/${PV}/install-tools ${D}${R}/info ${D}${R}/man
	rm ${D}${R}/bin/gccbug
	lstrip ${D}${R}/bin/* ${D}${R}/libexec/gcc/`tc-host`/${PV}/*
}
