include toolchain
include lutils

DESCRIPTION="Einfaches Hilfesystem für tyndur"
HOMEPAGE=""
SRC_URI=""

LICENSE="none"

BUILD_DEPEND="=ncurses-5.6 =libnxml-0.18.3"
RUN_DEPEND=""

src_unpack() {
	cd ${S}

	git init -q
	git pull -q git://git.tyndur.org/help.git
}

src_compile() {
	cd ${S}

	`tc-cc` -c -I include -I `tc-incdir` -I `tc-incdir`/ncurses -Wall -O2 *.c
	`tc-cc` -o help *.o -L `tc-libdir` -lnxml -lncursesw
}

src_install() {
	cd ${S}

	mkdir -p "${D}${R}/bin"
	cp help "${D}${R}/bin/thelp"
	mkdir -p "${D}${R}/doc"
	cp *.xml "${D}${R}/doc/"
}
