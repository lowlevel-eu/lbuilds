include toolchain
include lutils

DESCRIPTION="Ein Musikabspielprogramm"
HOMEPAGE="https://github.com/XanClic/xply"
SRC_URI="https://github.com/XanClic/xply/archive/master.tar.gz"
DONT_CACHE_SRC=true

LICENSE="MIT"

BUILD_DEPEND="=libogg-1.1.4 =libvorbis-1.2.3 =libmpg123-1.13.3 =libcdi-42"
RUN_DEPEND=""

MY_S="${S}/${P}"

src_unpack() {
    lunpack master.tar.gz || die "could not unpack"
    mv xply-master ${MY_S}
}

src_compile() {
    cd ${MY_S}

    lmake CC="`tc-cc` -I `tc-incdir` -L `tc-libdir`" OUTPUT="null tyn" || die "make failed"
    cd ..
}

src_install() {
    cd ${MY_S}

    mkdir -p ${D}/${R}
    lmake install INSTALL_TO="${D}${R}" || die "make install failed"
    rm -rf ${D}${R}/share
}
