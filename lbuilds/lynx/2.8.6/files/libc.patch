+#ifdef __TYNDUR__
+
+#undef NETREAD
+#define NETREAD(s,b,l)  tyndur_netread((s),(b),(l))
+
+static ssize_t tyndur_netread(int fd, void* buf, size_t n)
+{
+    ssize_t ret;
+    uint64_t timeout = get_tick_count() + 1000000;
+
+    do {
+        ret = read(fd, buf, n);
+    } while ((ret == 0) && (get_tick_count() < timeout));
+
+    return ret;
+}
+
+static int select(int nfds, fd_set *readfds, fd_set *writefds,
+                  fd_set *exceptfds, struct timeval *timeout)
+{
+    uint32_t* rd = (uint32_t*) readfds;
+    uint32_t* wr = (uint32_t*) writefds;
+    uint32_t* err = (uint32_t*) exceptfds;
+    int c;
+    FILE* f;
+
+    int ret = 0;
+    int i;
+    for (i = 0; i < 32; i++) {
+        if (*rd & (1 << i)) {
+            f = fdopen(*rd, NULL);
+            c = fgetc(f);
+            if (c == 0 || c == EOF) {
+                *rd &= ~(1 << i);
+            } else {
+                ungetc(c, f);
+                ret++;
+            }
+        }
+        if (*wr & (1 << i)) ret++;
+        if (*err & (1 << i)) ret++;
+    }
+
+    return ret;
+}
+#endif
