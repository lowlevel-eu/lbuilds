+#include <errno.h>
+static inline ssize_t readlink(const char *path, char *buf, size_t bufsiz)
+{
+    ssize_t len;
+
+    FILE* file = fopen(path, "lr");
+    if (file == NULL) {
+        errno = EIO;
+        return -1;
+    }
+    len = fread(buf, 1, bufsiz, file);
+    fclose(file);
+
+    return len;
+}
+
+static inline void *bsearch(const void *key, const void *base, size_t nel,
+    size_t width, int (*compar)(const void *, const void *))
+{
+    size_t i;
+    const void* obj;
+
+    for (i = 0; i < nel; i++) {
+        obj = base + (width * i);
+        if (compar(key, obj) == 0) {
+            return (void*) obj;
+        }
+    }
+
+    return NULL;
+}
