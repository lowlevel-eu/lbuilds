+static void start_tyndur_program(const char* const* args)
+{
+    char* cmd = strdup(*args++);
+    char* old;
+
+    while (*args != NULL) {
+        old = cmd;
+        asprintf(&cmd, "%s %s", old, *args);
+        free(old);
+        args++;
+    }
+
+    init_execute(cmd);
+    free(cmd);
+}
