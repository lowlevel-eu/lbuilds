+
+static int is_relative(const char* path)
+{
+    const char* pos_slash;
+    const char* pos_pipe;
+
+    if (path == NULL || *path == 0) {
+        return 1;
+    }
+
+    if (*path == '/') {
+        return 0;
+    }
+
+    pos_slash = strchr(path, '/');
+    if (!pos_slash) {
+        return 1;
+    }
+
+    if ((pos_slash > path) && (pos_slash[-1] != ':')) {
+        return 1;
+    }
+
+    pos_pipe = strchr(path, '|');
+    if (!pos_pipe) {
+        return 0;
+    }
+
+    return pos_pipe < pos_slash;
+}
