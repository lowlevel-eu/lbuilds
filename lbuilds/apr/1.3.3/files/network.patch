--- apr-1.3.3.orig/support/unix/waitio.c
+++ apr-1.3.3/support/unix/waitio.c
@@ -61,6 +61,40 @@ apr_status_t apr_wait_for_io_or_timeout(
     }
 }
 
+#elif defined(TYNDUR)
+
+#include <sys/select.h>
+
+apr_status_t apr_wait_for_io_or_timeout(apr_file_t *f, apr_socket_t *s,
+                                        int for_read)
+{
+    int ret;
+    int fd = f ? f->filedes : s->socketdes;
+    struct timeval timeout = {
+        .tv_sec = (f ? f->timeout : s->timeout) / 1000,
+        .tv_usec = ((f ? f->timeout : s->timeout) % 1000) * 1000,
+    };
+    fd_set fds;
+
+    FD_ZERO(&fds);
+    FD_SET(fd, &fds);
+
+    ret = select(fd,
+        for_read ? &fds : NULL,
+        for_read ? NULL : &fds,
+        NULL,
+        &timeout);
+
+    if (ret < 0) {
+        return errno;
+    } else if (ret) {
+        return APR_SUCCESS;
+    } else {
+        return APR_TIMEUP;
+    }
+}
+
+
 #else /* !WAITIO_USES_POLL */
 
