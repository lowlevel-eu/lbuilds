include lutils
include toolchain

DESCRIPTION="bsd-games"
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/Bsd-games"
SRC_URI="ftp://metalab.unc.edu/pub/Linux/games/${P}.tar.gz"


LICENSE="BSD"

BUILD_DEPEND="=ncurses-5.6 =termcap-1.3.1"
RUN_DEPEND=""

MY_S="${S}/${P}"

src_unpack() {
	lunpack ${P}.tar.gz
	cd ${MY_S}

    ln -s ${F} patches
    [ -f ${F}/series ] && ln -s ${F}/series series
    for i in ${F}/*.patch; do
        [ -L series ] || echo `basename $i` >> series
        (which quilt > /dev/null 2>&1) || (patch -p1 < $i) || die "Fehler beim Anwenden von $i"
    done
    (which quilt > /dev/null 2>&1) && (quilt push -a || die "Fehler beim Anwenden der Patches")
}

src_configure() {
	cd ${MY_S}

	echo bsd_games_cfg_build_dirs=\"hack\" >> config.params
	echo bsd_games_cfg_install_prefix=\"${D}\" >> config.params

	bsd_games_cfg_cc="`tc-cc`" \
	bsd_games_cfg_host_cc="cc" \
	bsd_games_cfg_other_cflags="-I`tc-incdir` -I${MY_S}/include" \
	bsd_games_cfg_ncurses_includes="-I`tc-incdir`/ncurses" \
	bsd_games_cfg_base_libs="-L`tc-libdir`" \
	./configure || die "configure failed"
}


src_compile() {
	cd ${MY_S}

	lmake hack/makedefs || die "make failed"
	lmake || die "make failed"
}

src_install() {
	cd ${MY_S}
	mkdir -p "${D}/${R}/bin"
	cp hack/hack "${D}/${R}/bin"
}
