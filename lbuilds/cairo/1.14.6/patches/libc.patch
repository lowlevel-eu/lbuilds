+}
+
+#define DBL_EPSILON __DBL_EPSILON__
+#define frexp __builtin_frexp
+#define modf __builtin_modf
+
+typedef struct {
+    long quot;
+    long rem;
+} ldiv_t;
+
+static inline ldiv_t ldiv(long n, long d)
+{
+    return (ldiv_t) {
