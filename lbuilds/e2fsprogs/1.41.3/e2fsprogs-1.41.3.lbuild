include lutils
include toolchain

DESCRIPTION=""
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/libnxml"
SRC_URI="http://prdownloads.sourceforge.net/e2fsprogs/${P}.tar.gz"

LICENSE="GPL-2"

BUILD_DEPEND=""
RUN_DEPEND=""

MY_S="${S}/${P}"

src_unpack() {
	lunpack ${P}.tar.gz

	cd ${MY_S} || die "${MY_S} existiert nicht"
    ln -s ${F} patches
    for i in ${F}/*.patch; do
        echo `basename $i` >> series
        (which quilt > /dev/null 2>&1) || (patch -p1 < $i) || die "Fehler beim Anwenden von $i"
    done
    (which quilt > /dev/null 2>&1) && quilt push -a
}

src_configure() {
	cd ${MY_S}

	./configure \
		CC=`tc-cc` \
		--build=`tc-build` \
		--target=`tc-host` \
		--host=`tc-host` \
		--prefix="${R}" \
        --disable-testio-debug \
        --disable-debugfs \
        --disable-imager \
        --disable-resizer \
        --disable-tls \
        --disable-uuidd \
        --disable-nls \
        --disable-rpath \
		|| die "configure failed"
}

src_compile() {
	cd ${MY_S}

	lmake || die "make failed"
	cd ..
}

src_install() {
	cd ${MY_S}

	# Sonst gibts Fehler
	mkdir -p "${D}${R}/bin"
	lmake -j1 DESTDIR="${D}" install || die "make install failed"

    # Noch ein bisschen umraeumen
    mv ${D}${R}/sbin/* ${D}${R}/bin/
    rmdir ${D}${R}/lib
    rmdir ${D}${R}/sbin
}
