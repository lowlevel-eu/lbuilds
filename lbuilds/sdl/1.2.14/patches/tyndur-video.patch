Index: src/SDL-1.2.14/src/video/tyndur/SDL_tyndurvideo.c
===================================================================
--- /dev/null
+++ src/SDL-1.2.14/src/video/tyndur/SDL_tyndurvideo.c
@@ -0,0 +1,274 @@
+/*
+    SDL - Simple DirectMedia Layer
+    Copyright (C) 1997-2009 Sam Lantinga
+
+    This library is free software; you can redistribute it and/or
+    modify it under the terms of the GNU Lesser General Public
+    License as published by the Free Software Foundation; either
+    version 2.1 of the License, or (at your option) any later version.
+
+    This library is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+    Lesser General Public License for more details.
+
+    You should have received a copy of the GNU Lesser General Public
+    License along with this library; if not, write to the Free Software
+    Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+
+    Sam Lantinga
+    slouken@libsdl.org
+*/
+#include "SDL_config.h"
+
+/* Dummy SDL video driver implementation; this is just enough to make an
+ *  SDL-based application THINK it's got a working video driver, for
+ *  applications that call SDL_Init(SDL_INIT_VIDEO) when they don't need it,
+ *  and also for use as a collection of stubs when porting SDL to a new
+ *  platform for which you haven't yet written a valid video driver.
+ *
+ * This is also a great way to determine bottlenecks: if you think that SDL
+ *  is a performance problem for a given platform, enable this driver, and
+ *  then see if your application runs faster without video overhead.
+ *
+ * Initial work by Ryan C. Gordon (icculus@icculus.org). A good portion
+ *  of this was cut-and-pasted from Stephane Peter's work in the AAlib
+ *  SDL video driver.  Renamed to "TYNDUR" by Sam Lantinga.
+ */
+
+#include "SDL_video.h"
+#include "SDL_mouse.h"
+#include "../SDL_sysvideo.h"
+#include "../SDL_pixels_c.h"
+#include "../../events/SDL_events_c.h"
+
+#include "SDL_tyndurvideo.h"
+#include "SDL_tyndurevents_c.h"
+#include "SDL_tyndurmouse_c.h"
+
+#define TYNDURVID_DRIVER_NAME "dummy"
+
+/* Initialization/Query functions */
+static int TYNDUR_VideoInit(_THIS, SDL_PixelFormat *vformat);
+static SDL_Rect **TYNDUR_ListModes(_THIS, SDL_PixelFormat *format, Uint32 flags);
+static SDL_Surface *TYNDUR_SetVideoMode(_THIS, SDL_Surface *current, int width, int height, int bpp, Uint32 flags);
+static int TYNDUR_SetColors(_THIS, int firstcolor, int ncolors, SDL_Color *colors);
+static void TYNDUR_VideoQuit(_THIS);
+
+/* Hardware surface functions */
+static int TYNDUR_AllocHWSurface(_THIS, SDL_Surface *surface);
+static int TYNDUR_LockHWSurface(_THIS, SDL_Surface *surface);
+static void TYNDUR_UnlockHWSurface(_THIS, SDL_Surface *surface);
+static void TYNDUR_FreeHWSurface(_THIS, SDL_Surface *surface);
+
+/* etc. */
+static void TYNDUR_UpdateRects(_THIS, int numrects, SDL_Rect *rects);
+
+/* TYNDUR driver bootstrap functions */
+
+static int TYNDUR_Available(void)
+{
+    return 1;
+}
+
+static void TYNDUR_DeleteDevice(SDL_VideoDevice *device)
+{
+	SDL_free(device->hidden);
+	SDL_free(device);
+}
+
+static SDL_VideoDevice *TYNDUR_CreateDevice(int devindex)
+{
+	SDL_VideoDevice *device;
+
+	/* Initialize all variables that we clean on shutdown */
+	device = (SDL_VideoDevice *)SDL_malloc(sizeof(SDL_VideoDevice));
+	if ( device ) {
+		SDL_memset(device, 0, (sizeof *device));
+		device->hidden = (struct SDL_PrivateVideoData *)
+				SDL_malloc((sizeof *device->hidden));
+	}
+	if ( (device == NULL) || (device->hidden == NULL) ) {
+		SDL_OutOfMemory();
+		if ( device ) {
+			SDL_free(device);
+		}
+		return(0);
+	}
+	SDL_memset(device->hidden, 0, (sizeof *device->hidden));
+
+	/* Set the function pointers */
+	device->VideoInit = TYNDUR_VideoInit;
+	device->ListModes = TYNDUR_ListModes;
+	device->SetVideoMode = TYNDUR_SetVideoMode;
+	device->CreateYUVOverlay = NULL;
+	device->SetColors = TYNDUR_SetColors;
+	device->UpdateRects = TYNDUR_UpdateRects;
+	device->VideoQuit = TYNDUR_VideoQuit;
+	device->AllocHWSurface = TYNDUR_AllocHWSurface;
+	device->CheckHWBlit = NULL;
+	device->FillHWRect = NULL;
+	device->SetHWColorKey = NULL;
+	device->SetHWAlpha = NULL;
+	device->LockHWSurface = TYNDUR_LockHWSurface;
+	device->UnlockHWSurface = TYNDUR_UnlockHWSurface;
+	device->FlipHWSurface = NULL;
+	device->FreeHWSurface = TYNDUR_FreeHWSurface;
+	device->SetCaption = NULL;
+	device->SetIcon = NULL;
+	device->IconifyWindow = NULL;
+	device->GrabInput = NULL;
+	device->GetWMInfo = NULL;
+	device->InitOSKeymap = TYNDUR_InitOSKeymap;
+	device->PumpEvents = TYNDUR_PumpEvents;
+
+	device->free = TYNDUR_DeleteDevice;
+
+	return device;
+}
+
+VideoBootStrap TYNDUR_bootstrap = {
+	TYNDURVID_DRIVER_NAME, "SDL driver for tyndur",
+	TYNDUR_Available, TYNDUR_CreateDevice
+};
+
+
+int TYNDUR_VideoInit(_THIS, SDL_PixelFormat *vformat)
+{
+	/*
+	fprintf(stderr, "WARNING: You are using the SDL dummy video driver!\n");
+	*/
+
+	/* Determine the screen depth (use default 8-bit depth) */
+	/* we change this during the SDL_SetVideoMode implementation... */
+	vformat->BitsPerPixel = 24;
+	vformat->BytesPerPixel = 3;
+
+    this->hidden->buffer = NULL;
+
+	/* We're done! */
+	return(0);
+}
+
+static SDL_Rect* modelist[] = {
+/*    & (SDL_Rect) { .w =  640, .h = 480 }, */
+    & (SDL_Rect) { .w =  800, .h = 600 },
+    & (SDL_Rect) { .w = 1024, .h = 768 },
+    NULL,
+};
+
+static SDL_Rect* modelist_empty[] = { NULL };
+
+SDL_Rect **TYNDUR_ListModes(_THIS, SDL_PixelFormat *format, Uint32 flags)
+{
+    if (format->BitsPerPixel != 24) {
+        return modelist_empty;
+    }
+
+    return modelist;
+}
+
+SDL_Surface *TYNDUR_SetVideoMode(_THIS, SDL_Surface *current,
+				int width, int height, int bpp, Uint32 flags)
+{
+	if ( this->hidden->buffer ) {
+		SDL_free( this->hidden->buffer );
+	}
+
+    if (bpp != 24) {
+        return NULL;
+    }
+
+    /* Modus wechseln */
+    this->hidden->context = libvideo_create_driver_context("vesa");
+    libvideo_use_driver_context(this->hidden->context);
+    libvideo_get_command_buffer(1024);
+
+    libvideo_change_device(0);
+    libvideo_change_color(0, 255, 0, 0);
+    libvideo_do_command_buffer();
+    if (libvideo_change_display_resolution(0, width, height, 24) != 0) {
+        SDL_SetError("Modus setzen fehlgeschlagen");
+        return NULL;
+    }
+
+    video_bitmap_t *front;
+    front = libvideo_get_frontbuffer_bitmap(0);
+    libvideo_change_target(front);
+    this->hidden->front = front;
+
+	/* Allocate the new pixel format for the screen */
+	if ( ! SDL_ReallocFormat(current, bpp, 0xff0000, 0xff00, 0xff, 0) ) {
+		SDL_free(this->hidden->buffer);
+		this->hidden->buffer = NULL;
+		SDL_SetError("Couldn't allocate new pixel format for requested mode");
+		return(NULL);
+	}
+
+    /* Framebuffer aufsetzen */
+    size_t buffer_size;
+    this->hidden->buffer = libvideo_open_upload_buffer(front, &buffer_size);
+    if (buffer_size != width * height * (bpp / 8)) {
+        SDL_SetError("Unerwartete Puffergroesse: %x\n", buffer_size);
+    }
+
+	SDL_memset(this->hidden->buffer, 0, width * height * (bpp / 8));
+
+	/* Set up the new mode framebuffer */
+	current->flags = flags & SDL_FULLSCREEN;
+	this->hidden->w = current->w = width;
+	this->hidden->h = current->h = height;
+	current->pitch = current->w * (bpp / 8);
+	current->pixels = this->hidden->buffer;
+    current->format->BitsPerPixel = 24;
+    current->format->BytesPerPixel = 3;
+
+	/* We're done */
+	return(current);
+}
+
+/* We don't actually allow hardware surfaces other than the main one */
+static int TYNDUR_AllocHWSurface(_THIS, SDL_Surface *surface)
+{
+	return(-1);
+}
+static void TYNDUR_FreeHWSurface(_THIS, SDL_Surface *surface)
+{
+	return;
+}
+
+/* We need to wait for vertical retrace on page flipped displays */
+static int TYNDUR_LockHWSurface(_THIS, SDL_Surface *surface)
+{
+	return(0);
+}
+
+static void TYNDUR_UnlockHWSurface(_THIS, SDL_Surface *surface)
+{
+	return;
+}
+
+static void TYNDUR_UpdateRects(_THIS, int numrects, SDL_Rect *rects)
+{
+    if (this->hidden->buffer) {
+        libvideo_upload_bitmap(this->hidden->front);
+    }
+}
+
+int TYNDUR_SetColors(_THIS, int firstcolor, int ncolors, SDL_Color *colors)
+{
+	/* do nothing of note. */
+	return(1);
+}
+
+/* Note:  If we are terminated, this could be called in the middle of
+   another SDL video routine -- notably UpdateRects.
+*/
+void TYNDUR_VideoQuit(_THIS)
+{
+	if (this->screen->pixels != NULL)
+	{
+		SDL_free(this->screen->pixels);
+		this->screen->pixels = NULL;
+	}
+}
