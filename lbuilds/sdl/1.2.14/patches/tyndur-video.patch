+    Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+
+    Sam Lantinga
+    slouken@libsdl.org
+*/
+#include "SDL_config.h"
+
+/* Being a tyndur driver, there's no event stream. We just define stubs for
+   most of the API. */
+
+#include "SDL.h"
+#include "../../events/SDL_sysevents.h"
+#include "../../events/SDL_events_c.h"
+
+#include "SDL_tyndurvideo.h"
+#include "SDL_tyndurevents_c.h"
+
+#include <init.h>
+#include <kbd.h>
+#include <syscall.h>
+#include <lostio.h>
+
+
+static SDL_keysym* get_keysym(int c)
+{
+    static SDL_keysym keysym;
+
+    keysym.scancode = c;
+    keysym.sym = c;
+    keysym.mod = KMOD_NONE;
+	keysym.unicode = 0;
+	if ( SDL_TranslateUNICODE ) {
+		/* Populate the unicode field with the ASCII value */
+		keysym.unicode = c;
+	}
+
+    return &keysym;
+}
+
+static pid_t kbc_pid;
+
+struct kbd_data {
+    uint8_t keycode;
+    uint8_t release;
+};
+
+struct keymap_entry {
+    wchar_t normal;
+    wchar_t shift;
+    wchar_t altgr;
+    wchar_t ctrl;
+};
+
+static struct keymap_entry keymap[128];
+
+static int get_sdl_keycode(uint8_t keycode)
+{
+    int c;
+
+    switch (keycode) {
+
+        case KEYCODE_ARROW_UP:      return SDLK_UP;
+        case KEYCODE_ARROW_DOWN:    return SDLK_DOWN;
+        case KEYCODE_ARROW_LEFT:    return SDLK_LEFT;
+        case KEYCODE_ARROW_RIGHT:   return SDLK_RIGHT;
+
+        case KEYCODE_INSERT:        return SDLK_INSERT;
+        case KEYCODE_DELETE:        return SDLK_DELETE;
+        case KEYCODE_HOME:          return SDLK_HOME;
+        case KEYCODE_END:           return SDLK_END;
+        case KEYCODE_PAGE_UP:       return SDLK_PAGEUP;
+        case KEYCODE_PAGE_DOWN:     return SDLK_PAGEDOWN;
+
+        case KEYCODE_SHIFT_LEFT:    return SDLK_LSHIFT;
+        case KEYCODE_SHIFT_RIGHT:   return SDLK_RSHIFT;
+        case KEYCODE_CONTROL_LEFT:  return SDLK_LCTRL;
+        case KEYCODE_CONTROL_RIGHT: return SDLK_RCTRL;
+        case KEYCODE_ALT:           return SDLK_LALT;
+        case KEYCODE_ALTGR:         return SDLK_MODE;
+
+        case KEYCODE_F1:            return SDLK_F1;
+        case KEYCODE_F2:            return SDLK_F2;
+        case KEYCODE_F3:            return SDLK_F3;
+        case KEYCODE_F4:            return SDLK_F4;
+        case KEYCODE_F5:            return SDLK_F5;
+        case KEYCODE_F6:            return SDLK_F6;
+        case KEYCODE_F7:            return SDLK_F7;
+        case KEYCODE_F8:            return SDLK_F8;
+        case KEYCODE_F9:            return SDLK_F9;
+        case KEYCODE_F10:           return SDLK_F10;
+        case KEYCODE_F11:           return SDLK_F11;
+        case KEYCODE_F12:           return SDLK_F12;
+
+        case KEYCODE_KP_0:          return SDLK_KP0;
+        case KEYCODE_KP_1:          return SDLK_KP1;
+        case KEYCODE_KP_2:          return SDLK_KP2;
+        case KEYCODE_KP_3:          return SDLK_KP3;
+        case KEYCODE_KP_4:          return SDLK_KP4;
+        case KEYCODE_KP_5:          return SDLK_KP5;
+        case KEYCODE_KP_6:          return SDLK_KP6;
+        case KEYCODE_KP_7:          return SDLK_KP7;
+        case KEYCODE_KP_8:          return SDLK_KP8;
+        case KEYCODE_KP_9:          return SDLK_KP9;
+
+        case KEYCODE_KP_PLUS:       return SDLK_KP_PLUS;
+        case KEYCODE_KP_MINUS:      return SDLK_KP_MINUS;
+        case KEYCODE_KP_MUL:        return SDLK_KP_MULTIPLY;
+        case KEYCODE_KP_DIV:        return SDLK_KP_DIVIDE;
+        case KEYCODE_KP_DECIMAL:    return SDLK_KP_PERIOD;
+        case KEYCODE_KP_ENTER:      return SDLK_KP_ENTER;
+
+        default:
+            c = keymap[keycode].normal;
+            if (c == '\n') {
+                return SDLK_RETURN;
+            }
+
+            return c;
+    }
+}
+
+static void rpc_kbd_callback(pid_t pid, uint32_t cid, size_t data_size,
+    void* data)
+{
+    struct kbd_data* kbd_data = data;
+    SDL_keysym* keysym;
+    int keycode;
+    char buf[16];
+
+    /* Pruefen, ob die Nachricht in Ordnung ist */
+    if ((pid != kbc_pid) || (data_size != 2)) {
+        return;
+    }
+
+    /* Keycode anhand von vterm:/keymap uebersetzen */
+    if (kbd_data->keycode > 127) {
+        return;
+    }
+
+    p();
+
+    keycode = get_sdl_keycode(kbd_data->keycode);
+    keysym = get_keysym(keycode);
+
+    if (kbd_data->release) {
+        SDL_PrivateKeyboard(SDL_RELEASED, keysym);
+    } else {
+        SDL_PrivateKeyboard(SDL_PRESSED, keysym);
+    }
+
+    v();
+
+    /*
+     * Und stdin auslesen, sonst landen alle Tastendrücke nach dem Beenden in
+     * der Shell. Benutzt werden sie nicht.
+     */
+    if (IS_LIO2(stdin->res)) {
+        lio_readf(stdin->res, 0, sizeof(buf), buf, LIO_REQ_FILEPOS);
+    }
+}
+
+int TYNDUR_init_events(void)
+{
+    FILE* f;
+    int ret;
+
+    /* Keymap einlesen */
+    f = fopen("vterm:/keymap", "r");
+    if (!f) {
+        return -1;
+    }
+
+    ret = fread(keymap, sizeof(struct keymap_entry), 128, f);
+    fclose(f);
+
+    /* TODO 2048 ist nur Workaround fuer LIOv1 */
+    if (ret != 128 && ret != 2048) {
+        return -1;
+    }
+
+    /* RPC-Handler fuer die Callbacks von kbc einrichten */
+    register_message_handler(KBD_RPC_CALLBACK, rpc_kbd_callback);
+
+    /* Bei kbc registrieren */
+    kbc_pid = init_service_get("kbc");
+    if (!kbc_pid) {
+        return -1;
+    }
+
+    /* Callback registrtrieren bei kbc */
+    return -!rpc_get_dword(kbc_pid, KBD_RPC_REGISTER_CALLBACK, 0, NULL);
+}
+
+struct mousedata {
+    int32_t x;
+    int32_t y;
+    uint8_t buttons;
+    uint8_t btn_down;
+    uint8_t btn_up;
+    uint8_t padding;
+} __attribute__((packed));
+
+void TYNDUR_PumpEvents(_THIS)
+{
+    /* Maus abfragen */
+    if (this->hidden->mousedata) {
+        struct mousedata in;
+        fread(&in, 1, sizeof(in), this->hidden->mousedata);
+
+        if (in.x || in.y) {
+            SDL_PrivateMouseMotion(0, 1, in.x, in.y);
+        }
+
+        if (in.btn_down & 0x1)
+            SDL_PrivateMouseButton(SDL_PRESSED, SDL_BUTTON_LEFT, 0, 0);
+        if (in.btn_down & 0x2)
+            SDL_PrivateMouseButton(SDL_PRESSED, SDL_BUTTON_RIGHT, 0, 0);
+        if (in.btn_down & 0x4)
+            SDL_PrivateMouseButton(SDL_PRESSED, SDL_BUTTON_MIDDLE, 0, 0);
+
+        if (in.btn_up & 0x1)
+            SDL_PrivateMouseButton(SDL_RELEASED, SDL_BUTTON_LEFT, 0, 0);
+        if (in.btn_up & 0x2)
+            SDL_PrivateMouseButton(SDL_RELEASED, SDL_BUTTON_RIGHT, 0, 0);
+        if (in.btn_up & 0x4)
+            SDL_PrivateMouseButton(SDL_RELEASED, SDL_BUTTON_MIDDLE, 0, 0);
+    }
+}
+
+void TYNDUR_InitOSKeymap(_THIS)
+{
+	/* do nothing. */
+}
+
+/* end of SDL_tyndurevents.c ... */
+
