Index: src/SDL-1.2.14/configure.in
===================================================================
--- src.orig/SDL-1.2.14/configure.in
+++ src/SDL-1.2.14/configure.in
@@ -936,6 +936,19 @@ CheckNANOX()
     fi
 }
 
+CheckTyndur()
+{
+    AC_ARG_ENABLE(ipod,
+AC_HELP_STRING([--enable-tyndur], [configure SDL to work with tyndur [[default=yes]]]),
+        , enable_tyndur=yes)
+
+    if test x$enable_tyndur = xyes; then
+        AC_DEFINE(SDL_VIDEO_DRIVER_TYNDUR)
+        SOURCES="$SOURCES $srcdir/src/video/tyndur/*.c"
+        have_video=yes
+    fi
+}
+
 dnl Find the X11 include and library directories
 CheckX11()
 {
@@ -2789,6 +2802,7 @@ case "$host" in
         ;;
     *-tyndur)
         ARCH=tyndur
+        CheckTyndur
         CheckDummyVideo
         CheckDummyAudio
         ;;
