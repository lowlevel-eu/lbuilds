+CheckTyndur()
+{
+    AC_ARG_ENABLE(ipod,
+AC_HELP_STRING([--enable-tyndur], [configure SDL to work with tyndur [[default=yes]]]),
+        , enable_tyndur=yes)
+
+    if test x$enable_tyndur = xyes; then
+        AC_DEFINE(SDL_VIDEO_DRIVER_TYNDUR)
+        AC_DEFINE(SDL_TIMER_TYNDUR)
+        SOURCES="$SOURCES $srcdir/src/video/tyndur/*.c"
+        SOURCES="$SOURCES $srcdir/src/timer/tyndur/*.c"
+        have_video=yes
+        have_timers=yes
+    fi
+}
+
 dnl Find the X11 include and library directories
 CheckX11()
 {
@@ -2789,6 +2805,7 @@ case "$host" in
         ;;
     *-tyndur)
         ARCH=tyndur
+        CheckTyndur
         CheckDummyVideo
         CheckDummyAudio
         ;;
