+*/
+#include "SDL_config.h"
+
+/* Being a tyndur driver, there's no event stream. We just define stubs for
+   most of the API. */
+
+#include "SDL.h"
+#include "../../events/SDL_sysevents.h"
+#include "../../events/SDL_events_c.h"
+
+#include "SDL_tyndurvideo.h"
+#include "SDL_tyndurevents_c.h"
+
+static int read_escape_sequence(void)
+{
+    switch (fgetc(stdin)) {
+        case 'O':
+            switch (fgetc(stdin)) {
+                case 'P': return(SDLK_F1);
+                case 'Q': return(SDLK_F2);
+                case 'R': return(SDLK_F3);
+                case 'S': return(SDLK_F4);
+            }
+            break;
+
+        case '[':
+            switch (fgetc(stdin)) {
+                case 'A': return(SDLK_UP);
+                case 'B': return(SDLK_DOWN);
+                case 'C': return(SDLK_RIGHT);
+                case 'D': return(SDLK_LEFT);
+                case 'F': return(SDLK_END);
+                case 'H': return(SDLK_HOME);
+
+                case '3': if (fgetc(stdin) == '~') return(SDLK_DELETE);
+                case '5': if (fgetc(stdin) == '~') return(SDLK_PAGEUP);
+                case '6': if (fgetc(stdin) == '~') return(SDLK_PAGEDOWN);
+
+                case '1':
+                      switch (fgetc(stdin)) {
+                          case '5': if (fgetc(stdin) == '~') return(SDLK_F5);
+                          case '7': if (fgetc(stdin) == '~') return(SDLK_F6);
+                          case '8': if (fgetc(stdin) == '~') return(SDLK_F7);
+                          case '9': if (fgetc(stdin) == '~') return(SDLK_F8);
+                      }
+
+                case '2':
+                      switch (fgetc(stdin)) {
+                          case '0': if (fgetc(stdin) == '~') return(SDLK_F9);
+                          case '1': if (fgetc(stdin) == '~') return(SDLK_F10);
+                          case '3': if (fgetc(stdin) == '~') return(SDLK_F11);
+                          case '4': if (fgetc(stdin) == '~') return(SDLK_F12);
+                          case '~': return(SDLK_INSERT);
+                      }
+            }
+    }
+
+    return EOF;
+}
+
+static SDL_keysym* get_keysym(int c)
+{
+    static SDL_keysym keysym;
+
+    keysym.scancode = c;
+    keysym.sym = c;
+    keysym.mod = KMOD_NONE;
+	keysym.unicode = 0;
+	if ( SDL_TranslateUNICODE ) {
+		/* Populate the unicode field with the ASCII value */
+		keysym.unicode = c;
+	}
+
+    return &keysym;
+}
+
+void TYNDUR_PumpEvents(_THIS)
+{
+	/* Tastatur abfragen */
+    static int old_key = 0;
+
+    if (old_key != 0) {
+        SDL_PrivateKeyboard(SDL_RELEASED, get_keysym(old_key));
+        old_key = 0;
+    }
+
+    int c = fgetc(stdin);
+    if (c != EOF) {
+        switch (c) {
+            case 10:
+                c = 13;
+                break;
+
+            case 27:
+                c = read_escape_sequence();
+                if (c == EOF)
+                    c = 27;
+                break;
+        }
+        SDL_PrivateKeyboard(SDL_PRESSED, get_keysym(c));
+        old_key = c;
+    }
+}
+
+void TYNDUR_InitOSKeymap(_THIS)
+{
+	/* do nothing. */
+}
+
+/* end of SDL_tyndurevents.c ... */
+
