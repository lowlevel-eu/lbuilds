include lutils
include toolchain

DESCRIPTION=""
HOMEPAGE="http://lowlevel.brainsware.org/wiki/index.php/LOST/Pakete/ncurses"
SRC_URI="http://ftp.gnu.org/gnu/ncurses/${P}.tar.gz"
PS="lib"

LICENSE="GPL-2"

BUILD_DEPEND=""
RUN_DEPEND=""

MY_S="${S}/${P}"

src_configure() {
	for d in build build-utf8; do
		mkdir $d
		cd $d

		widec=""
		if [ "$d" == "build-utf8" ]; then
			widec="--enable-widec"
		fi
		${MY_S}/configure \
			CC=`tc-cc` \
			--build=`tc-build` \
			--target=`tc-host` \
			--host=`tc-host` \
			--prefix="${R}" \
			--enable-debug \
			$widec \
			--with-trace \
			--with-fallbacks=tyndur,lost \
			--without-progs \
			--without-cxx \
			--without-cxx-binding \
			--without-ada \
			|| die "configure failed"
		cd ..
	done
}

src_compile() {
	for d in build build-utf8; do
		cd $d
		lmake || die "make failed"
		cd ..
	done
}

src_install() {
	# Sonst gibts Fehler
	mkdir -p "${D}${R}/bin"

	for d in build build-utf8; do
		cd $d
		lmake -j1 DESTDIR="${D}" install || die "make install failed"
		cd ..
	done

	# Noch ein Bisschen Speicher sparen
	rm -rf "${D}${R}/share/terminfo" "${D}${R}/lib/terminfo" "${D}${R}/bin"
}
